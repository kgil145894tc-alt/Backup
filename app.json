{
  "expo": {
    "name": "UMVCFIND",
    "slug": "UMVCFIND",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/design/logos/UMVC-Find.png",
    "scheme": "umvcfind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.umvcfind.app",
      "icon": "./assets/design/logos/UMVC-Find.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.umvcfind.app",
      "adaptiveIcon": {
        "backgroundColor": "#991F2B",
        "foregroundImage": "./assets/design/logos/UMVC-Find.png",
        "monochromeImage": "./assets/design/logos/UMVC-Find.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/design/logos/UMVC-Find.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow UMVCFIND to show your current location on the campus map."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#991F2B",
          "image": "./assets/design/logos/UMVC-Find.png",
          "imageWidth": 76
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99768ba9-f192-4591-b62a-457b51b55d50"
      }
    }
  }
}
